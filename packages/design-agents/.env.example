# Copy to .env and fill in to use real Claude calls.
# If ANTHROPIC_API_KEY is unset AND STILIO_LLM=mock (or unset), the system runs
# on the deterministic mock LLM so the full workflow can be tested offline.

ANTHROPIC_API_KEY=

# LLM backend: "auto" (default) | "anthropic" | "mock"
#   auto     -> anthropic if ANTHROPIC_API_KEY is set, else mock
STILIO_LLM=auto

# Default model + reasoning effort for agents (overridable per agent in code)
STILIO_MODEL=claude-opus-5
STILIO_EFFORT=high

# Where project memory files are written
STILIO_PROJECT_DIR=./projects
